########################################
# App
########################################
APP_NAME=document-registry-service
APP_ENV=local
APP_VERSION=1.0.0

########################################
# Server (Driver-based)
########################################
SERVER_DRIVER=http

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10
HTTP_WRITE_TIMEOUT=10

# GRPC (future)
GRPC_PORT=9090

########################################
# Logging
########################################
LOG_LEVEL=debug
LOG_FORMAT=json

########################################
# Database (Driver-based)
########################################
DB_DRIVER=postgres

# Postgres (Aurora / RDS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=document_registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=disable

# Connection Pool
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=5m

# Dynamo (future support)
DYNAMO_ENDPOINT=http://localhost:8000
DYNAMO_REGION=us-east-1

########################################
# AWS (Shared)
########################################
AWS_REGION=us-east-1

# Localstack / cloud-local support
AWS_ENDPOINT=http://localhost:4566
AWS_USE_PATH_STYLE=true

########################################
# S3 (Document Content Storage)
########################################
S3_BUCKET=document-registry
S3_PRESIGN_EXPIRY=15m
S3_ENDPOINT=http://localhost:4566
########################################
# SNS (Notifications)
########################################
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:document-events
SNS_EMAIL_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:document-email
SNS_ENDPOINT=http://localhost:4566

########################################
# Event Bus (Internal)
########################################
EVENT_BUS_BUFFER=64
EVENT_BUS_WORKERS=4

########################################
# Feature Toggles (Optional)
########################################
FEATURE_ENABLE_FULL_TEXT_SEARCH=false
FEATURE_ENABLE_NOTIFICATIONS=true

########################################
# Security / Misc
########################################
REQUEST_ID_HEADER=X-Request-ID
TRACE_ENABLED=true


AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=test
AWS_PROFILE=
AWS_SDK_LOAD_CONFIG=0
AWS_ENDPOINT=http://localhost:4566
AWS_USE_PATH_STYLE=true