meta {
  name: Approve Version
  type: http
  seq: 5
}

post {
  url: {{base_url}}/versions/{{version_id}}/approve
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "comment": "Approved - looks good",
    "role": "engineer"
  }
}

docs {
  Approve a version.
  
  Roles:
  - engineer
  - architect
  - product_manager
  
  Multiple approvals may be required based on approval policy.
  Version moves to APPROVED when all required approvals received.
}
