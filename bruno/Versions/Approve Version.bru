meta {
  name: Approve Version
  type: http
  seq: 5
}

post {
  url: {{base_url}}/versions/{{version_id}}/approve
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "comment": "Approved - looks good"
  }
}

docs {
  Approve a version.
  
  Authorization:
  - User must have approval roles (admin, architect, or engineer)
  - Approval role is automatically determined from user's role
  - Admin users approve as "technical" (first available role)
  - Architect users approve as "architect"
  - Engineer users approve as "technical"
  
  State Transitions:
  - If version is SUBMITTED: auto-transitions to IN_REVIEW, then creates approval
  - If version is IN_REVIEW: creates approval
  - When all required approvals collected: transitions to APPROVED
  
  Pattern document type requires:
  - 1 technical approval (from engineer or admin)
  - 1 architect approval (from architect or admin)
  
  Note: Same user cannot approve with multiple roles
}
