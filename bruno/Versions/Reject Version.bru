meta {
  name: Reject Version
  type: http
  seq: 6
}

post {
  url: {{base_url}}/versions/{{version_id}}/reject
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "comment": "Needs more detail in the authentication section",
    "role": "architect"
  }
}

docs {
  Reject a version.
  
  Version moves to REJECTED status.
  Can be resubmitted after fixes.
}
