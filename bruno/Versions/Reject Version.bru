meta {
  name: Reject Version
  type: http
  seq: 6
}

post {
  url: {{base_url}}/versions/{{version_id}}/reject
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "reason": "Needs more detail in the authentication section"
  }
}

docs {
  Reject a version.
  
  Authorization:
  - User must have approval roles (admin, architect, or engineer)
  - Product and viewer roles cannot reject
  
  State Transitions:
  - If version is SUBMITTED: auto-transitions to IN_REVIEW, then to REJECTED
  - If version is IN_REVIEW: transitions to REJECTED
  - Cannot reject from other states (DRAFT, APPROVED, PUBLISHED, etc.)
  
  Version moves to REJECTED status (terminal state).
  A new version must be created to resubmit content.
}
