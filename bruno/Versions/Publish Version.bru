meta {
  name: Publish Version
  type: http
  seq: 7
}

post {
  url: {{base_url}}/versions/{{version_id}}/publish
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "comment": "Publishing to production"
  }
}

docs {
  Publish an approved version.
  
  Workflow: APPROVED → PUBLISHED
  
  Only one version can be published at a time.
  Publishing a new version auto-deprecates the previous published version.
}
