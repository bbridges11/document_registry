meta {
  name: List Documents
  type: http
  seq: 3
}

get {
  url: {{base_url}}/documents?limit=20&offset=0
  body: none
  auth: none
}

headers {
  X-User-ID: {{user_id}}
}

params:query {
  limit: 20
  offset: 0
}

docs {
  List all documents with pagination.
  
  Query Parameters:
  - limit: Number of results (default: 20)
  - offset: Pagination offset (default: 0)
}
