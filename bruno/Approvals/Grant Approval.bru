meta {
  name: Grant Approval
  type: http
  seq: 1
}

post {
  url: {{base_url}}/versions/{{version_id}}/approvals/grant
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "role": "engineer",
    "comment": "LGTM - architecture looks good"
  }
}

script:post-response {
  if (res.status === 201) {
    console.log("Approval granted successfully");
  }
}

docs {
  Grant an approval for a version.
  
  Roles:
  - engineer
  - architect
  - product_manager
  
  Each user can only approve once per role.
  Multiple approvals may be required based on approval policy.
}
