meta {
  name: Get Approval
  type: http
  seq: 3
}

get {
  url: {{base_url}}/approvals/{{approval_id}}
  body: none
  auth: none
}

headers {
  X-User-ID: {{user_id}}
}

docs {
  Get details of a specific approval by ID.
  
  Returns:
  - Approval ID
  - Version ID
  - User ID and name
  - Role
  - Approved status
  - Comment
  - Created timestamp
}
