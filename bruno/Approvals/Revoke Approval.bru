meta {
  name: Revoke Approval
  type: http
  seq: 2
}

post {
  url: {{base_url}}/versions/{{version_id}}/approvals/revoke/{{user_id}}
  body: none
  auth: none
}

headers {
  X-User-ID: {{user_id}}
}

docs {
  Revoke a previously granted approval.
  
  Requires:
  - Version ID
  - User ID of the person whose approval to revoke
  
  Typically used when changes are made after approval
  or approval was granted in error.
}
