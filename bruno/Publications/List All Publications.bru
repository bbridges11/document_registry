meta {
  name: List All Publications
  type: http
  seq: 2
}

get {
  url: {{base_url}}/publications?limit=50&offset=0
  body: none
  auth: none
}

params:query {
  limit: 50
  offset: 0
}

headers {
  X-User-ID: {{user_id}}
}

docs {
  List all publications with pagination.
  
  **Admin Only**: This endpoint requires admin privileges.
  
  Query Parameters:
  - limit: Maximum results per page (default: 50, max: 100)
  - offset: Number of results to skip (default: 0)
  
  Returns:
  - publications: Array of publication objects
  - total: Total number of publications
  - limit: Applied limit
  - offset: Applied offset
  
  Use Case:
  - Audit all publication activity across the system
  - Monitor publication success/failure rates
  - Track which documents/versions have been published
}
