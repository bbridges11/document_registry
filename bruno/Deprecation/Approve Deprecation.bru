meta {
  name: Approve Deprecation
  type: http
  seq: 2
}

post {
  url: {{base_url}}/deprecations/{{deprecation_id}}/approve
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "comment": "Approved - migration path is clear"
  }
}

docs {
  Approve a deprecation request.
  
  Version moves to DEPRECATED status.
}
