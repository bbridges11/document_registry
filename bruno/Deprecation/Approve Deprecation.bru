meta {
  name: Approve Deprecation
  type: http
  seq: 2
}

post {
  url: {{base_url}}/versions/{{version_id}}/deprecation/approve
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "role": "admin",
    "comment": "Approved - migration path is clear"
  }
}

docs {
  Approve a deprecation request.
  
  **Endpoint**: POST /versions/:id/deprecation/approve
  
  **Required Fields**:
  - role: Approval role (admin, architect, technical)
  
  **Optional Fields**:
  - comment: Approval comment
  
  **Result**:
  - Adds approval to deprecation
  - When all required approvals received, version moves to DEPRECATED status
}
