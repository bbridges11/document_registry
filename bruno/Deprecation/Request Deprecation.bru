meta {
  name: Request Deprecation
  type: http
  seq: 1
}

post {
  url: {{base_url}}/versions/{{version_id}}/deprecate
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "reason": "Superseded by version 2.0.0",
    "deprecation_note": "Please migrate to version 2.0.0 by end of Q2"
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.body;
    bru.setVar("deprecation_id", data.id);
  }
}

docs {
  Request deprecation of a published version.
  
  **Endpoint**: POST /versions/:id/deprecate
  
  **Required Fields**:
  - reason: Why the version should be deprecated
  
  **Optional Fields**:
  - deprecation_note: Additional migration guidance
  
  **Flow**:
  - Creates deprecation request
  - For pattern documents: requires approval workflow
  - For auto-deprecation (when new version published): approved automatically
  
  **Auto-saves**: deprecation_id for approval/rejection operations
}
