meta {
  name: Deactivate User
  type: http
  seq: 5
}

post {
  url: {{base_url}}/users/{{created_user_id}}/deactivate
  body: none
  auth: none
}

headers {
  X-User-ID: {{user_id}}
}

docs {
  Deactivate a user account.
  
  Requires admin privileges (X-User-ID must be an admin).
  
  Deactivated users:
  - Cannot log in
  - Cannot perform actions
  - Remain in the system (not deleted)
  - Can be reactivated
}
