meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{base_url}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john.doe@example.com",
    "name": "John Doe",
    "role": "engineer"
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.body;
    bru.setVar("created_user_id", data.id);
  }
}

docs {
  Create a new user.
  
  Roles:
  - admin
  - engineer
  - architect
  - product_manager
  - viewer
  
  Auto-saves created_user_id for use in other requests.
}
