meta {
  name: Delete User
  type: http
  seq: 7
}

delete {
  url: {{base_url}}/users/{{created_user_id}}
  body: none
  auth: none
}

headers {
  X-User-ID: {{user_id}}
}

docs {
  Permanently delete a user.
  
  Requires admin privileges (X-User-ID must be an admin).
  
  ⚠️ WARNING: This is permanent and cannot be undone.
  
  Consider using Deactivate User instead for soft deletion.
}
