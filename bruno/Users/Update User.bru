meta {
  name: Update User
  type: http
  seq: 4
}

put {
  url: {{base_url}}/users/{{created_user_id}}
  body: json
  auth: none
}

headers {
  X-User-ID: {{user_id}}
  Content-Type: application/json
}

body:json {
  {
    "name": "John Doe (Senior)",
    "role": "architect"
  }
}

docs {
  Update a user's name and/or role.
  
  Requires admin privileges (X-User-ID must be an admin).
  
  Updatable fields:
  - name
  - role
  
  Cannot update:
  - email
  - active status (use activate/deactivate endpoints)
}
