meta {
  name: Activate User
  type: http
  seq: 6
}

post {
  url: {{base_url}}/users/{{created_user_id}}/activate
  body: none
  auth: none
}

headers {
  X-User-ID: {{user_id}}
}

docs {
  Activate a previously deactivated user account.
  
  Requires admin privileges (X-User-ID must be an admin).
  
  Activated users can:
  - Log in
  - Perform actions based on their role
}
