meta {
  name: Get User
  type: http
  seq: 2
}

get {
  url: {{base_url}}/users/{{created_user_id}}
  body: none
  auth: none
}

headers {
  X-User-ID: {{user_id}}
}

docs {
  Get a user by ID.
  
  Returns:
  - User ID
  - Email
  - Name
  - Role
  - Active status
  - Created/updated timestamps
}
