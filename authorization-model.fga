# Document Registry Authorization Model
# OpenFGA DSL v1.1

model
  schema 1.1

type user

type document
  relations
    # Direct relationships
    define owner: [user]
    define contributor: [user]
    define consumer: [user]
    
    # Published documents are viewable by everyone
    define published: [user:*]
    
    # Computed permissions
    define can_view: published or owner or contributor or consumer
    define can_edit: owner or contributor
    define can_delete: owner
    define can_manage_stakeholders: owner
    define can_create_version: owner or contributor

type version
  relations
    # Link to parent document
    define parent_document: [document]
    
    # Inherit permissions from document
    define can_view: can_view from parent_document
    define can_edit: can_edit from parent_document
    define can_submit: can_create_version from parent_document
    define can_review: owner from parent_document
    define can_approve: owner from parent_document
    define can_publish: owner from parent_document
